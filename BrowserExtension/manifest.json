{
  "manifest_version": 3,
  "name": "Flyleaf Browser Cookies",
  "description": "On-demand normal/private browser cookies for Flyleaf media extraction.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "key": "",
  "incognito": "split",
  "options_page": "options.html"
}
